    "@types/node": "24.10.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
