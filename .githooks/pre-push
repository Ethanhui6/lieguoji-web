#!/bin/sh
# Project-local guard: full acceptance, or the exact authorized playtest ref.
root=$(git rev-parse --show-toplevel) || exit 1

# Bind an accepted worktree to the one commit actually being uploaded.
case "$2" in
  https://github.com/Ethanhui6/lieguoji-web|https://github.com/Ethanhui6/lieguoji-web.git|git@github.com:Ethanhui6/lieguoji-web.git) ;;
  *) echo 'Release blocked: the push target is not this project repository.' >&2; exit 1 ;;
esac
head=$(git rev-parse HEAD) || exit 1
count=0
while read -r local_ref local_oid remote_ref remote_oid; do
  count=$((count + 1))
  if [ "$count" -gt 1 ] || [ "$local_oid" != "$head" ]; then
    echo 'Release blocked: push exactly the accepted HEAD; deletions and other revisions are not allowed.' >&2
    exit 1
  fi
  case "$remote_ref" in
    refs/heads/*) ;;
    *) echo 'Release blocked: this gate permits a single project branch candidate only.' >&2; exit 1 ;;
  esac
  if [ "$remote_oid" != "0000000000000000000000000000000000000000" ]; then
    git merge-base --is-ancestor "$remote_oid" "$head" || { echo 'Release blocked: only a fast-forward update is authorized.' >&2; exit 1; }
  fi
  accepted_remote_ref="$remote_ref"
done
[ "$count" -eq 1 ] || { echo 'Release blocked: no single candidate update was supplied.' >&2; exit 1; }
node "$root/scripts/check-release.mjs" --target-ref "$accepted_remote_ref" || exit 1
