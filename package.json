{
  "name": "lieguoji-web",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/check-dist.mjs",
    "build:cf": "npm run lint && npm run typecheck && npm run build",
    "check:full": "npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "check": "npm run check:full && npm run test:e2e",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "d3-delaunay": "6.0.4",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3-delaunay": "6.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
