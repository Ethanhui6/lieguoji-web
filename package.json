{
  "name": "lieguoji-ios",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "engine": "vite build -c vite.bridge.config.ts",
    "lint": "eslint src scripts functions",
