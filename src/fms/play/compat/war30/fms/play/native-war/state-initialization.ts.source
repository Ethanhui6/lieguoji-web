import {nativeRoundToEven} from '../native-economy/native-round';
/** Auto-generated state expansionism, 484F70/485720 -> 3EF650. This is an
 * independent persisted state property, not a government/personality proxy.
 * Original PlaceState/TryRebel copy the source state's value instead of
 * calling this generator. The random stream is an explicit browser port. */
export function nativeGenerateExpansionism(randomValue:()=>number):number{
 const f=Math.fround,x=f(f(f(randomValue())*f(5))+f(1));
 return f(nativeRoundToEven(x,1));
}
