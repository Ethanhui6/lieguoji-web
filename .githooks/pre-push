#!/bin/sh
# Push check (iOS repository): push only to this project's repository, with a clean tree,
# after a secret scan of everything the push adds and lint + types of the engine sources.
# The Swift engine, app build and screenshots run in GitHub Actions (ios-native-unsigned.yml).
root=$(git rev-parse --show-toplevel) || exit 1
case "$2" in
  https://github.com/Ethanhui6/lieguoji-web|https://github.com/Ethanhui6/lieguoji-web.git|git@github.com:Ethanhui6/lieguoji-web.git) ;;
  *) echo 'Push blocked: the target is not this project repository.' >&2; exit 1 ;;
esac
[ -z "$(git -C "$root" status --porcelain)" ] || { echo 'Push blocked: commit or remove local changes first.' >&2; exit 1; }
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  base="$remote_oid"
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    base=$(git -C "$root" merge-base "$local_oid" origin/main 2>/dev/null || echo "$remote_oid")
  fi
  node "$root/scripts/secret-scan.mjs" "$base" "$local_oid" || exit 1
done
cd "$root" && npm run --silent lint && npm run --silent typecheck || { echo 'Push blocked: lint or types failed.' >&2; exit 1; }
